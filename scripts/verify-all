        etape0_section.extend([
            '',
            f'## Contenu brut : \`{json_path}\`',
            '',
            '\`\`\`json',
            content,
            '\`\`\`',
            ''
        ])

for md_path in ['docs/audit/smoke-prod-render.md', 'docs/audit/smoke-prod.md', 'docs/audit/contrastes.md', 'docs/audit/console-errors.md']:
    if os.path.exists(md_path):
        with open(md_path, 'r', encoding='utf-8') as mf:
            m_content = mf.read().strip()
        etape0_section.extend([
            '',
            '---',
            '',
            m_content,
            ''
        ])

full_report = '\n'.join(etape0_section)
with open('rapport.md', 'w', encoding='utf-8') as rf:
    rf.write(full_report)
with open('docs/audit/rapport.md', 'w', encoding='utf-8') as rf2:
    rf2.write(full_report)
with open('docs/audit/lot8b.md', 'w', encoding='utf-8') as rf3:
    rf3.write(full_report)
with open('docs/audit/lot8b-9.md', 'w', encoding='utf-8') as rf4:
    rf4.write(full_report)
with open('docs/audit/lot10.md', 'w', encoding='utf-8') as rf5:
    rf5.write(full_report)
with open('VERIFY.md', 'w', encoding='utf-8') as vf:
    vf.write(verify_md)
"

rm -f "$ROOT_DIR/lot6-7-correctifs.zip" "$ROOT_DIR/lot8.zip" "$ROOT_DIR/lot8b-9.zip" "$ROOT_DIR/lot10.zip"

