    ('docs/audit/lot7/modale_avertissement_deconnexion_360x780.png', 360, 780, False),
    ('docs/audit/lot7/modale_avertissement_deconnexion_1440x900.png', 1440, 900, False),
    ('docs/audit/lot7/notification_reassignation_code_360x780.png', 360, 780, False),
