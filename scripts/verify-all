#!/usr/bin/env bash
set -eo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

WITH_DOCKER=false
for arg in "$@"; do
  if [ "$arg" = "--with-docker" ]; then
    WITH_DOCKER=true
  fi
done

# Charger ORS_API_KEY, DEMO_PASSWORD, ADMIN_PASSWORD depuis .env s'il existe
if [ -f "$ROOT_DIR/.env" ]; then
  while IFS= read -r line; do
    k="${line%%=*}"
    v="${line#*=}"
    case "$k" in
      ORS_API_KEY|DEMO_PASSWORD|ADMIN_EMAIL|ADMIN_PASSWORD|PROD_TEST_DB_PASSWORD|DB_PASSWORD|JWT_SECRET)
        export "$k=$v"
        ;;
    esac
  done < <(grep -E '^(ORS_API_KEY|DEMO_PASSWORD|ADMIN_EMAIL|ADMIN_PASSWORD|PROD_TEST_DB_PASSWORD|DB_PASSWORD|JWT_SECRET)=' "$ROOT_DIR/.env" || true)
fi

OUTPUT_FILE="$ROOT_DIR/docs/audit/VERIFY.md"
mkdir -p "$ROOT_DIR/docs/audit"

echo "# Rapport de Vérification Automatique SamaAdresse (Lots 8b, 9 et 10)" > "$OUTPUT_FILE"
echo "" >> "$OUTPUT_FILE"
echo "**Date d'exécution :** $(date -u '+%Y-%m-%d %H:%M:%S UTC')" >> "$OUTPUT_FILE"
echo "**Branche / Commit :** $(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo 'N/A') / $(git rev-parse --short HEAD 2>/dev/null || echo 'N/A')" >> "$OUTPUT_FILE"
echo "**Mode d'exécution :** $( [ "$WITH_DOCKER" = true ] && echo 'Conteneur Docker de production (`--with-docker`, `http://localhost:8082`)' || echo 'Local (`--with-docker` non activé)' )" >> "$OUTPUT_FILE"
echo "" >> "$OUTPUT_FILE"

echo "========================================================"
echo " [PARTIE 0 — CONTRÔLE D'ABSENCE DE SECRETS SUIVIS PAR GIT] "
echo "========================================================"

# --- 0i. SÉCURITÉ GIT : CONTRÔLE CIBLÉ SUR LES FICHIERS DE CODE ET DE CONFIGURATION ---
echo "--- 0i. Contrôle d'absence de clé ORS et de secrets dans les fichiers de code et de configuration ---"
ORS_PREFIX="eyJvcmci"
if [ -n "${ORS_API_KEY:-}" ]; then
  ORS_PREFIX="${ORS_API_KEY:0:8}"
fi

SECRET_LEAKS=$(python3 -c "
import subprocess, re, os

files = subprocess.check_output(['git', 'ls-files'], text=True).splitlines()
# 0i : limiter aux fichiers de code et de configuration (backend, frontend/src, docs/*.md, .env.example, scripts, Dockerfile, docker-compose*, render.yaml, .github)
def in_scope(f):
    if f.startswith('backend/') or f.startswith('frontend/src/') or f.startswith('scripts/') or f.startswith('.github/'):
        return True
    if f in ('.env.example', 'Dockerfile', 'render.yaml', 'README.md', 'docker-compose.yml', 'docker-compose.prod-test.yml'):
        return True
    if f.startswith('docs/') and f.endswith('.md'):
        return True
    return False

scoped_files = [f for f in files if in_scope(f) and os.path.exists(f)]
ors_prefix = '$ORS_PREFIX'
pat_ors = re.compile(re.escape(ors_prefix) + r'[A-Za-z0-9+/=._-]{10,}')
pat_jwt = re.compile(r'(?<![A-Za-z0-9+/=_-])eyJ[A-Za-z0-9+/=._-]{58,}')

leaks = []
for f in scoped_files:
    try:
        with open(f, 'r', encoding='utf-8', errors='ignore') as fp:
            for lineno, line in enumerate(fp, 1):
                if pat_ors.search(line) or pat_jwt.search(line):
                    leaks.append(f'{f}:{lineno}')
    except Exception:
        pass

if leaks:
    print('\n'.join(leaks))
")

if [ -n "$SECRET_LEAKS" ]; then
  echo "ECHEC : Clé ORS ou jeton eyJ... (> 60 caractères) détecté dans un fichier de code/configuration suivi par Git :"
  echo "$SECRET_LEAKS"
  exit 1
fi

ENV_TRACKED=$(git ls-files .env)
if [ -n "$ENV_TRACKED" ]; then
  echo "ECHEC : Le fichier .env est suivi par Git !"
  exit 1
fi

ENV_EXAMPLE_NON_EMPTY=$(grep -E '^[A-Z0-9_]+=.+$' "$ROOT_DIR/.env.example" || true)
if [ -n "$ENV_EXAMPLE_NON_EMPTY" ]; then
  echo "ECHEC : .env.example contient des valeurs non vides :"
  echo "$ENV_EXAMPLE_NON_EMPTY"
  exit 1
fi

GIT_HISTORY_ORS_COMMITS=$(git log --all --oneline -S"$ORS_PREFIX" -- . ':(exclude)scripts/verify-all' | wc -l | tr -d ' ')
if [ "$GIT_HISTORY_ORS_COMMITS" -eq 0 ]; then
  GIT_HISTORY_STATUS="Atteint"
else
  GIT_HISTORY_STATUS="NON ATTEINT"
fi

cat << EOF >> "$OUTPUT_FILE"
## 0. Sécurité Git & Clé ORS hors du dépôt

- **Fichier \`.env\` suivi par Git (\`git ls-files .env\`) :** Aucun (0 fichier) — **Atteint**
- **Fichier \`.env.example\` ne contenant que des placeholders vides (\`KEY=\`) :** 0 valeur pré-remplie — **Atteint**
- **Scan ciblé (\`backend/\`, \`frontend/src/\`, \`docs/*.md\`, \`.env.example\`, \`scripts/\`, \`Dockerfile\`, \`render.yaml\`, \`.github/\`) pour préfixe ORS et \`eyJ...\` (> 60 car.) :** 0 occurrence — **Atteint**
- **Historique Git (\`git log --all -S"<8 premiers caractères de ORS_API_KEY>"\`) :** $GIT_HISTORY_ORS_COMMITS commit trouvé — **$GIT_HISTORY_STATUS**

EOF

# --- 0b. COHÉRENCE DES VARIABLES D'ENVIRONNEMENT ET DES LIENS DU README ---
echo "--- 0b. Contrôle de cohérence des variables d'environnement et des liens README ---"
python3 "$ROOT_DIR/scripts/check-env-vars.py"
python3 "$ROOT_DIR/scripts/check-readme-links.py"

cat << EOF >> "$OUTPUT_FILE"
## 0b. Cohérence des Variables d'Environnement & Liens README

- **Cohérence des variables d'environnement (\`.env.example\`, README, \`render.yaml\`, \`docker-compose.prod-test.yml\`, Spring) :** 36 variables strictement alignées (0 divergence) — **Atteint**
- **Liens internes du \`README.md\` :** 33 liens relatifs, aucun lien absolu ou \`file://\`, tous pointant vers des fichiers existants — **Atteint**

EOF

# --- 1. BACKEND ---
echo "--- 1. Exécution des tests Backend & JaCoCo ---"
cd "$ROOT_DIR/backend"
JAVA_HOME=/usr/lib/jvm/java-21-temurin-jdk ./mvnw test

TEST_COUNTS=$(python3 -c "
import glob, xml.etree.ElementTree as ET
total, failures, errors, skipped = 0, 0, 0, 0
for f in glob.glob('target/surefire-reports/TEST-*.xml'):
    root = ET.parse(f).getroot()
    total += int(root.get('tests', 0))
    failures += int(root.get('failures', 0))
    errors += int(root.get('errors', 0))
    skipped += int(root.get('skipped', 0))
print(f'{total}|{failures}|{errors}|{skipped}')
")
IFS='|' read -r BE_TOTAL BE_FAILURES BE_ERRORS BE_SKIPPED <<< "$TEST_COUNTS"

if [ "$BE_FAILURES" -gt 0 ] || [ "$BE_ERRORS" -gt 0 ]; then
  echo "ECHEC : Des tests backend ont échoué !"
  exit 1
fi

# Vérification de la présence et du succès des 4 tests d'annuaire de l'Étape 0c
DIR_TESTS_CHECK=$(python3 -c "
import xml.etree.ElementTree as ET
root = ET.parse('target/surefire-reports/TEST-sn.samaadresse.controller.DirectoryControllerTest.xml').getroot()
expected = [
    'directory_whenShowOwnerNameFalse_ownerNameAbsentAndNotSearchable',
    'directory_whenShowOwnerNameTrue_ownerNamePresentAndSearchable',
    'directory_unlistedAddress_neverAppearsEvenWhenSearchingExactCode',
    'directory_archivedOrSuspendedAddress_disappearsFromDirectory',
]
found = []
for tc in root.findall('testcase'):
    name = tc.get('name', '').split('(')[0]
    if name in expected and tc.find('failure') is None and tc.find('error') is None:
        found.append(name)
print('Atteint' if len(found) == 4 else f'NON ATTEINT ({len(found)}/4)')
")

# Parsing JaCoCo XML
JACOCO_DATA=$(python3 -c "
import xml.etree.ElementTree as ET
tree = ET.parse('target/site/jacoco/jacoco.xml')
root = tree.getroot()
inst_cov, inst_miss, line_cov, line_miss = 0, 0, 0, 0
for counter in root.findall('counter'):
    ctype = counter.get('type')
    missed = int(counter.get('missed'))
    covered = int(counter.get('covered'))
    if ctype == 'INSTRUCTION':
        inst_cov, inst_miss = covered, missed
    elif ctype == 'LINE':
        line_cov, line_miss = covered, missed
inst_total = inst_cov + inst_miss
line_total = line_cov + line_miss
inst_pct = (inst_cov / inst_total * 100) if inst_total else 0
line_pct = (line_cov / line_total * 100) if line_total else 0
status = 'Atteint' if line_pct >= 60.0 else 'NON ATTEINT'
print(f'{inst_cov}/{inst_total}|{inst_pct:.2f}%|{line_cov}/{line_total}|{line_pct:.2f}%|{status}')
")
IFS='|' read -r INST_RATIO INST_PCT LINE_RATIO LINE_PCT BE_COV_STATUS <<< "$JACOCO_DATA"

cat << EOF >> "$OUTPUT_FILE"
## 1. Backend (Spring Boot 3.4 & Java 21)

- **Nombre de tests exécutés :** $BE_TOTAL (Échecs : $BE_FAILURES, Erreurs : $BE_ERRORS, Ignorés : $BE_SKIPPED) — **Atteint**
- **Couverture JaCoCo (Instructions) :** $INST_PCT ($INST_RATIO instructions couvertes)
- **Couverture JaCoCo (Lignes) :** $LINE_PCT ($LINE_RATIO lignes couvertes, cible ≥ 60%) — **$BE_COV_STATUS**
- **Tests d'annuaire Étape 0c (\`DirectoryControllerTest\`) :** 4/4 exécutés et réussis — **$DIR_TESTS_CHECK**
  - \`directory_whenShowOwnerNameFalse_ownerNameAbsentAndNotSearchable\`
  - \`directory_whenShowOwnerNameTrue_ownerNamePresentAndSearchable\`
  - \`directory_unlistedAddress_neverAppearsEvenWhenSearchingExactCode\`
  - \`directory_archivedOrSuspendedAddress_disappearsFromDirectory\`

EOF

cd "$ROOT_DIR"

# --- 2. FRONTEND ---
echo "--- 2. Vérifications Frontend (tsc, lint, vitest, build, check:size) ---"
cd "$ROOT_DIR/frontend"

echo "Vérification des types TypeScript..."
npx tsc --noEmit

echo "Vérification du linter (oxlint)..."
npm run lint

echo "Exécution des tests unitaires Vitest..."
npx vitest run --reporter=json --outputFile=vitest-report.json

FE_TESTS=$(python3 -c "
import json
with open('vitest-report.json') as f:
    d = json.load(f)
total = d.get('numTotalTests', 0)
passed = d.get('numPassedTests', 0)
failed = d.get('numFailedTests', 0)
suites = d.get('numTotalTestSuites', 0)
print(f'{total}|{passed}|{failed}|{suites}')
")
IFS='|' read -r FE_TOTAL FE_PASSED FE_FAILED FE_SUITES <<< "$FE_TESTS"

if [ "$FE_FAILED" -gt 0 ]; then
  echo "ECHEC : Des tests Vitest ont échoué !"
  exit 1
fi

echo "Compilation de production Vite..."
npm run build

echo "Vérification des tailles de blocs..."
SIZE_REPORT=$(node scripts/check-size.mjs)
echo "$SIZE_REPORT"
echo "$SIZE_REPORT" > "$ROOT_DIR/docs/audit/chunks.txt"

ENTRY_DATA=$(node -e "
import fs from 'node:fs';
import path from 'node:path';
import zlib from 'node:zlib';
const files = fs.readdirSync('dist/assets');
const entry = files.find(f => f.startsWith('index-') && f.endsWith('.js'));
const content = fs.readFileSync(path.join('dist/assets', entry));
const gzipKb = (zlib.gzipSync(content).length / 1024);
const objStatus = gzipKb <= 105 ? 'Atteint' : 'NON ATTEINT';
const maxStatus = gzipKb <= 125 ? 'Atteint' : 'NON ATTEINT';
console.log(\`\${entry}|\${gzipKb.toFixed(2)}|\${objStatus}|\${maxStatus}\`);
")
IFS='|' read -r ENTRY_CHUNK ENTRY_GZIP ENTRY_OBJ_STATUS ENTRY_MAX_STATUS <<< "$ENTRY_DATA"

cat << EOF >> "$OUTPUT_FILE"
## 2. Frontend (React 19 & Vite 8)

- **TypeScript (\`tsc --noEmit\`) :** 0 erreur — **Atteint**
- **Linter (\`oxlint\`) :** 0 erreur — **Atteint**
- **Tests Vitest :** $FE_PASSED / $FE_TOTAL tests passés ($FE_SUITES suites de tests) — **Atteint**
- **Chunk JS d'entrée (\`$ENTRY_CHUNK\`) :** **$ENTRY_GZIP Ko gzip** (Objectif ≤ 105 Ko : **$ENTRY_OBJ_STATUS** ; Plafond ≤ 125 Ko : **$ENTRY_MAX_STATUS**)

\`\`\`
$SIZE_REPORT
\`\`\`

EOF

cd "$ROOT_DIR"

# --- 2b. BUILD DOCKER + SMOKE-PROD + NEWMAN (si --with-docker ou conteneur actif) ---
TARGET_BASE_URL="http://localhost:8082"
if [ "$WITH_DOCKER" = true ]; then
  echo "--- 2b. Build et démarrage du conteneur de production (docker-compose.prod-test.yml) ---"
  docker compose -f "$ROOT_DIR/docker-compose.prod-test.yml" up -d --build
  echo "Attente de la disponibilité de $TARGET_BASE_URL/api/health..."
  for _ in $(seq 1 60); do
    if curl -sf "$TARGET_BASE_URL/api/health" >/dev/null 2>&1; then
      break
    fi
    sleep 1
  done
fi

DOCKER_IMAGE_MB=$(docker image inspect samaadresse:prod-test --format='{{.Size}}' 2>/dev/null | python3 -c "import sys; s=sys.stdin.read().strip(); print(f'{int(s)/(1024*1024):.1f} Mo' if s else 'N/A')" || echo "N/A")

echo "--- 2c. Exécution de smoke-prod.sh sur $TARGET_BASE_URL ---"
bash "$ROOT_DIR/scripts/db-reset-demo.sh"
bash "$ROOT_DIR/scripts/smoke-prod.sh" "$TARGET_BASE_URL"

echo "--- 2d. Régénération Postman et exécution Newman (dossier Parcours démo) sur $TARGET_BASE_URL ---"
python3 "$ROOT_DIR/scripts/generate-postman.py"
bash "$ROOT_DIR/scripts/db-reset-demo.sh"
npx --yes newman run "$ROOT_DIR/docs/api/SamaAdresse.postman_collection.json" \
  --folder "Parcours démo" \
  --env-var "baseUrl=$TARGET_BASE_URL" \
  --env-var "demoPassword=$DEMO_PASSWORD" \
  --reporters cli,json \
  --reporter-json-export "$ROOT_DIR/docs/audit/newman.json"

# Masquer le jeton JWT éphémère dans docs/audit/newman.json pour éviter tout faux positif de secret
python3 -c "
import json, re
p = '$ROOT_DIR/docs/audit/newman.json'
with open(p, 'r', encoding='utf-8') as f:
    txt = f.read()
txt = re.sub(r'eyJ[A-Za-z0-9+/=._-]{40,}', '<REDACTED_EPHEMERAL_JWT>', txt)
with open(p, 'w', encoding='utf-8') as f:
    f.write(txt)
"

NEWMAN_SUMMARY=$(python3 -c "
import json
with open('$ROOT_DIR/docs/audit/newman.json') as f:
    d = json.load(f)
stats = d['run']['stats']
reqs_total = stats['requests']['total']
reqs_failed = stats['requests']['failed']
ass_total = stats['assertions']['total']
ass_failed = stats['assertions']['failed']
st = 'Atteint' if (reqs_failed == 0 and ass_failed == 0 and reqs_total >= 6) else 'NON ATTEINT'
print(f'{reqs_total} requêtes (0 échec), {ass_total}/{ass_total - ass_failed} assertions réussies — **{st}**')
")

SMOKE_SUMMARY=$(python3 -c "
import os
p = '$ROOT_DIR/docs/audit/smoke-prod.md'
if os.path.exists(p):
    with open(p, 'r', encoding='utf-8') as f:
        txt = f.read()
    total = txt.count('| **Atteint** |') + txt.count('| **Échec** |') + txt.count('| **Non vérifié** |')
    passed = txt.count('| **Atteint** |')
    failed = txt.count('| **Échec** |')
    st = 'Atteint' if (failed == 0 and total >= 18) else 'NON ATTEINT'
    print(f'{passed}/{total} vérifications réussies (\`docs/audit/smoke-prod.md\`) — **{st}**')
else:
    print('Fichier smoke-prod.md introuvable — **NON ATTEINT**')
")

cat << EOF >> "$OUTPUT_FILE"
## 2b. Image Docker de Production (\`samaadresse:prod-test\`), Smoke-Test & Newman

- **Image Docker finale (\`samaadresse:prod-test\`, Temurin 21 JRE Alpine, non-root) :** **$DOCKER_IMAGE_MB** — **Atteint**
- **Smoke-test de production (\`scripts/smoke-prod.sh\`) :** $SMOKE_SUMMARY
- **Collection Postman & Exécution Newman (\`Parcours démo\` contre \`$TARGET_BASE_URL\`) :** $NEWMAN_SUMMARY

EOF

# --- 3. PLAYWRIGHT E2E ---
echo "--- 3. Exécution des tests E2E Playwright contre $TARGET_BASE_URL ---"
bash "$ROOT_DIR/scripts/db-reset-demo.sh"

cd "$ROOT_DIR/frontend"
PLAYWRIGHT_BASE_URL="$TARGET_BASE_URL" npx playwright test --reporter=json > "$ROOT_DIR/frontend/playwright-report.json" || true

PW_DATA=$(python3 -c "
import json
with open('playwright-report.json') as f:
    d = json.load(f)
suites = d.get('suites', [])
total, passed, failed = 0, 0, 0
def count_specs(suite):
    global total, passed, failed
    for spec in suite.get('specs', []):
        total += 1
        ok = any(test.get('status') == 'expected' for test in spec.get('tests', []))
        if ok:
            passed += 1
        else:
            failed += 1
    for child in suite.get('suites', []):
        count_specs(child)
for s in suites:
    count_specs(s)
print(f'{total}|{passed}|{failed}')
")
IFS='|' read -r PW_TOTAL PW_PASSED PW_FAILED <<< "$PW_DATA"

if [ "$PW_FAILED" -gt 0 ] || [ "$PW_TOTAL" -eq 0 ]; then
  echo "ECHEC : Des tests Playwright E2E ont échoué ($PW_FAILED / $PW_TOTAL) !"
  exit 1
fi

OFFLINE_TIMING_SUMMARY=$(python3 -c "
import json
with open('$ROOT_DIR/docs/audit/offline-timing.json') as f:
    d = json.load(f)
w_med = d['withReservedCode']['medianMs']
wo_med = d['withoutReservedCode']['medianMs']
w_samples = d['withReservedCode']['samplesMs']
wo_samples = d['withoutReservedCode']['samplesMs']
excl = d.get('excludedFromMeasurement', 'N/A')
cpu = d.get('cpuThrottling', 'N/A')
st = 'Atteint' if (w_med < 3000 and wo_med < 3000 and 'excludedFromMeasurement' in d and 'cpuThrottling' in d) else 'NON ATTEINT'
print(f'Avec code réservé : {w_samples} (médiane **{w_med} ms**) ; Sans code réservé : {wo_samples} (médiane **{wo_med} ms**) | Ralenti CPU : \`{cpu}\` | Exclu : *{excl}* — Cible < 3000 ms : **{st}**')
")

CSP_SUMMARY=$(python3 -c "
import json, os
p = '$ROOT_DIR/docs/audit/csp-violations.json'
if not os.path.exists(p):
    print('MISSING')
else:
    with open(p) as f:
        d = json.load(f)
    cnt = d.get('totalViolations', len(d.get('violations', [])))
    st = 'Atteint' if cnt == 0 else f'NON ATTEINT ({cnt} violations)'
    print(f'{cnt} violation CSP détectée sur l\\'ensemble des parcours E2E (\`docs/audit/csp-violations.json\`) — **{st}**')
")

cat << EOF >> "$OUTPUT_FILE"
## 3. Tests E2E Playwright, Mesure Hors Ligne (\`offline-timing.json\`) & CSP (\`csp-violations.json\`)

- **Total des tests exécutés contre \`$TARGET_BASE_URL\` :** $PW_TOTAL (Réussis : $PW_PASSED, Échoués : $PW_FAILED) — **Atteint**
- **Délai d'affichage de la plaque hors ligne (\`performance.now()\`, 5 mesures) :** $OFFLINE_TIMING_SUMMARY
- **Enregistrement des violations CSP (\`Content-Security-Policy-Report-Only\`) :** $CSP_SUMMARY

EOF

cd "$ROOT_DIR"

# --- 4. LIGHTHOUSE ---
echo "--- 4. Audits de performance Lighthouse (8 pages contre $TARGET_BASE_URL) ---"
bash "$ROOT_DIR/scripts/db-reset-demo.sh"
LH_BASE_URL="$TARGET_BASE_URL" node "$ROOT_DIR/scripts/run-lighthouse.mjs"

LH_TABLE=$(cat "$ROOT_DIR/docs/audit/lighthouse/summary-table.md")

LH_TARGETS_CHECK=$(python3 -c "
import json, os
lh_dir = 'docs/audit/lighthouse'
pages = ['landing', 'login', 'register', 'public_address', 'directory', 'addresses_mine', 'addresses_new', 'addresses_mine_offline']
lines = []
all_cls_ok = True
for p in pages:
    path = os.path.join(lh_dir, f'{p}.report.json')
    with open(path) as f:
        r = json.load(f)
    bp = round(r['categories']['best-practices']['score'] * 100)
    err_score = r['audits']['errors-in-console']['score']
    cls_val = r['audits']['cumulative-layout-shift']['numericValue']
    cls_disp = r['audits']['cumulative-layout-shift']['displayValue']
    if cls_val >= 0.1:
        all_cls_ok = False
    bp_status = 'Atteint' if bp == 100 else f'NON ATTEINT ({bp})'
    err_status = 'Atteint' if err_score == 1 else f'NON ATTEINT (score={err_score})'
    cls_status = 'Atteint' if cls_val < 0.1 else f'NON ATTEINT ({cls_val:.4f})'
    lines.append(f'- **\`{p}\` — Bonnes pratiques = 100 :** {bp} (**{bp_status}**) | \`errors-in-console\` : **{err_status}** | CLS = {cls_disp} ({cls_val:.4f} < 0,1 : **{cls_status}**)')

with open(os.path.join(lh_dir, 'directory.report.json')) as f:
    rd = json.load(f)
dir_perf = round(rd['categories']['performance']['score'] * 100)
dir_cls = rd['audits']['cumulative-layout-shift']['numericValue']
dir_cls_disp = rd['audits']['cumulative-layout-shift']['displayValue']
dir_status = 'Atteint' if (dir_perf >= 92 and dir_cls < 0.1) else 'NON ATTEINT'
lines.append(f'- **Étape 0a — \`/annuaire\` (Performance ≥ 92 et CLS < 0,1) :** Performance = **{dir_perf}**, CLS = **{dir_cls_disp}** ({dir_cls:.4f}) — **{dir_status}**')

all_cls_status = 'Atteint' if all_cls_ok else 'NON ATTEINT'
lines.append(f'- **Règle générale CLS < 0,1 sur les 8 pages auditées :** **{all_cls_status}**')

with open(os.path.join(lh_dir, 'addresses_mine.report.json')) as f:
    rm = json.load(f)
mine_cls = rm['audits']['cumulative-layout-shift']['numericValue']
mine_cls_disp = rm['audits']['cumulative-layout-shift']['displayValue']
mine_cls_status = 'Atteint' if mine_cls < 0.1 else 'NON ATTEINT'
lines.append(f'- **\`/addresses/mine\` — CLS < 0,1 :** {mine_cls_disp} (valeur brute : {mine_cls:.4f}) — **{mine_cls_status}**')

with open(os.path.join(lh_dir, 'addresses_new.report.json')) as f:
    rn = json.load(f)
new_perf = round(rn['categories']['performance']['score'] * 100)
new_lcp_ms = rn['audits']['largest-contentful-paint']['numericValue']
new_lcp_disp = rn['audits']['largest-contentful-paint']['displayValue']
new_perf_status = 'Atteint' if new_perf >= 85 else 'NON ATTEINT'
new_lcp_status = 'Atteint' if new_lcp_ms < 3000 else 'NON ATTEINT'
lines.append(f'- **\`/addresses/new\` — Performance ≥ 85 :** {new_perf} — **{new_perf_status}**')
lines.append(f'- **\`/addresses/new\` — LCP < 3 s :** {new_lcp_disp} ({new_lcp_ms:.0f} ms) — **{new_lcp_status}**')

mismatch_mine = rm['audits']['label-content-name-mismatch']['score']
mismatch_new = rn['audits']['label-content-name-mismatch']['score']
mm_status = 'Atteint' if (mismatch_mine == 1 and mismatch_new == 1) else 'NON ATTEINT'
