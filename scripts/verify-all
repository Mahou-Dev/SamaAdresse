        errors.append(f'MISSING:{f}')
        continue
    with Image.open(f) as img:
        w, h = img.size
    with open(f, 'rb') as fp:
        md5 = hashlib.md5(fp.read()).hexdigest()

    if md5 in hashes:
        errors.append(f'DUPLICATE_MD5:{f}=={hashes[md5]}({md5})')
    hashes[md5] = f

    dim_ok = (w == exp_w and (h >= exp_h if is_fullpage else h == exp_h))
    if not dim_ok:
        errors.append(f'BAD_DIM:{f}:{w}x{h}!=expected_{exp_w}x{exp_h}')

    st = 'Atteint' if dim_ok else 'NON ATTEINT'
    rows.append(f'| \`{f}\` | {w}×{h} | \`{md5}\` | **{st}** |')

print('| Capture | Dimensions réelles | MD5 | Statut |')
print('|---|:---:|---|:---:|')
for r in rows:
    print(r)

