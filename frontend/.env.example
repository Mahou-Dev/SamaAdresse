# Configuration frontend Vite (sans aucun secret)
# Laisser vide pour utiliser la même origine (recommandé en production et en dev via le proxy Vite -> http://localhost:8082)
VITE_API_BASE_URL=
# Adresse publique optionnelle pour les liens de partage / QR code (par défaut : window.location.origin)
VITE_PUBLIC_APP_URL=
# Fournisseur de tuiles Leaflet (OpenStreetMap par défaut)
VITE_TILE_URL=
VITE_TILE_ATTRIBUTION=
