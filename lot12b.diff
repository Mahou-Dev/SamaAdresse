+/* Report header */
+
+.lh-report-icon {
+  display: flex;
+  align-items: center;
+  padding: 10px 12px;
+  cursor: pointer;
+}
+.lh-report-icon[disabled] {
+  opacity: 0.3;
+  pointer-events: none;
+}
