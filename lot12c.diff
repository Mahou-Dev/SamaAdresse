+  content: "";
+  margin: 4px;
+  background-repeat: no-repeat;
+  width: var(--report-icon-size);
+  height: var(--report-icon-size);
+  opacity: 0.7;
+  display: inline-block;
+  vertical-align: middle;
+}
+.lh-report-icon:hover::before {
+  opacity: 1;
+}
