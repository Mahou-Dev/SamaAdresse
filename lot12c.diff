@@ -0,0 +1,147 @@
+import React, { useEffect, useRef } from 'react';
+import { AlertTriangle, AlertCircle, Info, Loader2 } from 'lucide-react';
+
+export interface ConfirmDialogProps {
+  isOpen: boolean;
+  onClose: () => void;
+  onConfirm: () => void | Promise<void>;
+  title: string;
+  description: React.ReactNode;
+  confirmLabel?: string;
+  cancelLabel?: string;
+  variant?: 'danger' | 'warning' | 'info';
+  isLoading?: boolean;
+}
+
+export const ConfirmDialog: React.FC<ConfirmDialogProps> = ({
+  isOpen,
+  onClose,
+  onConfirm,
+  title,
+  description,
+  confirmLabel = 'Confirmer',
+  cancelLabel = 'Annuler',
+  variant = 'danger',
+  isLoading = false,
+}) => {
+  const modalRef = useRef<HTMLDivElement>(null);
+  const previousActiveElement = useRef<HTMLElement | null>(null);
+
+  useEffect(() => {
+    if (isOpen) {
+      previousActiveElement.current = document.activeElement as HTMLElement;
+
+      const handleKeyDown = (e: KeyboardEvent) => {
+        if (e.key === 'Escape' && !isLoading) {
+          onClose();
+          return;
+        }
+
+        if (e.key === 'Tab' && modalRef.current) {
+          const focusables = modalRef.current.querySelectorAll<HTMLElement>(
+            'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
+          );
+          if (focusables.length === 0) return;
+          const first = focusables[0];
+          const last = focusables[focusables.length - 1];
+
+          if (e.shiftKey && document.activeElement === first) {
+            e.preventDefault();
+            last.focus();
+          } else if (!e.shiftKey && document.activeElement === last) {
+            e.preventDefault();
+            first.focus();
+          }
+        }
+      };
+
+      document.addEventListener('keydown', handleKeyDown);
+      document.body.style.overflow = 'hidden';
+
+      setTimeout(() => {
+        const cancelBtn = modalRef.current?.querySelector<HTMLButtonElement>('[data-action="cancel"]');
+        cancelBtn?.focus();
+      }, 50);
+
+      return () => {
+        document.removeEventListener('keydown', handleKeyDown);
+        document.body.style.overflow = '';
+        previousActiveElement.current?.focus();
+      };
+    }
+  }, [isOpen, onClose, isLoading]);
+
+  if (!isOpen) return null;
+
+  const variantConfig = {
+    danger: {
+      iconBg: 'bg-[#FBF7EF] border-[#8A3112]/30 text-[#8A3112]',
+      icon: AlertCircle,
+      confirmBtn: 'bg-[#8A3112] hover:bg-[#9A3816] text-[#FBF7EF]',
+    },
+    warning: {
+      iconBg: 'bg-[#F2ECE1] border-[#8A3112]/30 text-[#8A3112]',
+      icon: AlertTriangle,
+      confirmBtn: 'bg-[#B84A24] hover:bg-[#8A3112] text-[#FBF7EF]',
+    },
+    info: {
+      iconBg: 'bg-[#F2ECE1] border-[#1D528F]/30 text-[#1D528F]',
+      icon: Info,
+      confirmBtn: 'bg-[#12304F] hover:bg-[#0C233B] text-[#FBF7EF]',
+    },
+  }[variant];
+
+  const Icon = variantConfig.icon;
+
+  return (
+    <div
+      role="dialog"
+      aria-modal="true"
+      aria-labelledby="confirm-dialog-title"
+      aria-describedby="confirm-dialog-description"
+      className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50"
+    >
+      <div
+        ref={modalRef}
+        className="bg-[#FBF7EF] rounded-2xl border border-[#766B5B] shadow-2xl p-6 max-w-md w-full space-y-4"
+      >
+        <div className="flex items-start gap-3.5">
+          <div
+            className={`w-10 h-10 rounded-full border flex items-center justify-center shrink-0 ${variantConfig.iconBg}`}
+          >
+            <Icon className="w-5 h-5" />
+          </div>
+          <div className="space-y-1">
+            <h2 id="confirm-dialog-title" className="text-base font-bold text-[#231A15]">
+              {title}
+            </h2>
+            <div id="confirm-dialog-description" className="text-xs sm:text-sm text-[#5C4D44] leading-relaxed">
+              {description}
+            </div>
+          </div>
+        </div>
+
+        <div className="flex flex-col-reverse sm:flex-row items-center justify-end gap-2.5 pt-3 border-t border-[#766B5B]/30">
+          <button
+            type="button"
+            data-action="cancel"
+            disabled={isLoading}
+            onClick={onClose}
+            className="w-full sm:w-auto px-4 py-2.5 rounded-lg border border-[#766B5B] bg-[#FBF7EF] text-[#231A15] hover:bg-[#F2ECE1] text-xs font-bold transition min-h-[44px] cursor-pointer touch-target disabled:opacity-50 focus-visible:outline-2 focus-visible:outline-[#F2B233]"
+          >
+            {cancelLabel}
+          </button>
+          <button
+            type="button"
+            disabled={isLoading}
+            onClick={onConfirm}
+            className={`w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-lg text-xs font-bold transition min-h-[44px] cursor-pointer touch-target shadow-sm disabled:opacity-50 focus-visible:outline-2 focus-visible:outline-[#F2B233] ${variantConfig.confirmBtn}`}
+          >
+            {isLoading && <Loader2 className="w-4 h-4 animate-spin" />}
+            <span>{confirmLabel}</span>
+          </button>
+        </div>
+      </div>
+    </div>
+  );
+};
diff --git a/frontend/src/components/ui/DataTable.tsx b/frontend/src/components/ui/DataTable.tsx
new file mode 100644
index 0000000..0dd8c8f
--- /dev/null
+++ b/frontend/src/components/ui/DataTable.tsx
@@ -0,0 +1,167 @@
+import React from 'react';
+import { ArrowUpDown, ArrowUp, ArrowDown } from 'lucide-react';
+
+export interface Column<T> {
+  key: string;
+  header: string;
+  sortable?: boolean;
+  className?: string;
+  render?: (row: T, index: number) => React.ReactNode;
+}
+
+export interface DataTableProps<T> {
+  data: T[];
+  columns: Column<T>[];
+  keyExtractor: (row: T) => string;
+  sortKey?: string | null;
+  sortDirection?: 'asc' | 'desc' | null;
+  onSort?: (key: string) => void;
+  renderMobileCard?: (row: T, index: number) => React.ReactNode;
+  emptyMessage?: string;
+  onRowClick?: (row: T) => void;
+  selectedId?: string | null;
+  ariaLabel?: string;
+}
+
+export function DataTable<T>({
+  data,
+  columns,
+  keyExtractor,
+  sortKey,
+  sortDirection,
+  onSort,
+  renderMobileCard,
+  emptyMessage = 'Aucune donnée disponible',
+  onRowClick,
+  selectedId,
+  ariaLabel = 'Tableau de données',
+}: DataTableProps<T>) {
+  if (data.length === 0) {
+    return (
+      <div className="p-8 text-center rounded-xl bg-[#FBF7EF] border border-[#766B5B] text-xs text-[#5C4D44]">
+        {emptyMessage}
+      </div>
+    );
+  }
+
+  return (
+    <div className="w-full">
+      {/* Version Table Desktop (>= 768 px) */}
+      <div className="hidden md:block rounded-xl border border-[#766B5B] bg-[#FBF7EF] shadow-[0_2px_0_rgba(35,26,21,0.06)] overflow-hidden">
+        <div className="overflow-x-auto">
+          <table className="w-full text-left border-collapse text-xs" aria-label={ariaLabel}>
+            <thead>
+              <tr className="bg-[#F2ECE1] border-b border-[#766B5B] text-[#231A15]">
+                {columns.map((col) => {
+                  const isSorted = sortKey === col.key;
+                  const sortAria = !col.sortable
+                    ? undefined
+                    : isSorted
+                    ? sortDirection === 'asc'
+                      ? 'ascending'
+                      : 'descending'
+                    : 'none';
+
+                  return (
+                    <th
+                      key={col.key}
+                      scope="col"
+                      aria-sort={sortAria}
+                      className={`py-3 px-4 font-bold ${col.className || ''}`}
+                    >
+                      {col.sortable && onSort ? (
+                        <button
+                          type="button"
+                          onClick={() => onSort(col.key)}
+                          className="inline-flex items-center gap-1.5 hover:text-[#12304F] transition cursor-pointer font-bold focus-visible:outline-2 focus-visible:outline-[#F2B233] rounded px-1 -mx-1"
+                        >
+                          <span>{col.header}</span>
+                          {isSorted ? (
+                            sortDirection === 'asc' ? (
+                              <ArrowUp className="w-3.5 h-3.5 text-[#12304F]" />
+                            ) : (
+                              <ArrowDown className="w-3.5 h-3.5 text-[#12304F]" />
+                            )
+                          ) : (
+                            <ArrowUpDown className="w-3.5 h-3.5 text-[#5C4D44]/50" />
+                          )}
+                        </button>
+                      ) : (
+                        <span>{col.header}</span>
+                      )}
+                    </th>
+                  );
+                })}
+              </tr>
+            </thead>
+            <tbody className="divide-y divide-[#766B5B]/30">
+              {data.map((row, index) => {
+                const rowKey = keyExtractor(row);
+                const isSelected = selectedId === rowKey;
+                const isClickable = !!onRowClick;
+
+                return (
+                  <tr
+                    key={rowKey}
+                    onClick={() => onRowClick?.(row)}
+                    className={`transition ${
+                      isSelected
+                        ? 'bg-[#F2ECE1] font-semibold'
+                        : isClickable
+                        ? 'hover:bg-[#F2ECE1]/60 cursor-pointer'
+                        : 'hover:bg-[#F2ECE1]/30'
+                    }`}
+                  >
+                    {columns.map((col) => (
+                      <td key={col.key} className={`py-3 px-4 ${col.className || ''}`}>
+                        {col.render
+                          ? col.render(row, index)
+                          : String((row as Record<string, any>)[col.key] ?? '')}
+                      </td>
+                    ))}
+                  </tr>
+                );
+              })}
+            </tbody>
+          </table>
+        </div>
+      </div>
+
+      {/* Version Cartes Mobile (< 768 px) */}
+      <div className="md:hidden space-y-3">
+        {data.map((row, index) => {
+          const rowKey = keyExtractor(row);
+          if (renderMobileCard) {
+            return (
+              <div key={rowKey} onClick={() => onRowClick?.(row)}>
+                {renderMobileCard(row, index)}
+              </div>
+            );
+          }
+
+          // Fallback par défaut si renderMobileCard n'est pas fourni
+          return (
+            <div
+              key={rowKey}
+              onClick={() => onRowClick?.(row)}
+              className={`p-4 rounded-xl border border-[#766B5B] bg-[#FBF7EF] shadow-sm space-y-2 text-xs ${
+                onRowClick ? 'cursor-pointer active:bg-[#F2ECE1]' : ''
+              }`}
+            >
+              {columns.map((col) => (
+                <div key={col.key} className="flex items-start justify-between gap-2">
+                  <span className="font-semibold text-[#5C4D44] shrink-0">{col.header} :</span>
+                  <div className="text-right text-[#231A15]">
+                    {col.render
+                      ? col.render(row, index)
+                      : String((row as Record<string, any>)[col.key] ?? '')}
+                  </div>
+                </div>
+              ))}
+            </div>
+          );
+        })}
+      </div>
+    </div>
+  );
+}
