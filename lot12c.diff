+-- ==============================================================================
+
+\set ON_ERROR_STOP on
+
+-- 1. ÉTAT AVANT PURGE (SELECT pré-purge)
+\echo '=== [PRÉ-PURGE] INVENTAIRE DES COMPTES DE TEST CIBLÉS ==='
