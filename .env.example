# ==============================================================================
# SamaAdresse - Configuration d'environnement (.env)
# ==============================================================================
# Ce fichier recense l'ensemble des variables d'environnement configurables.
# Copiez ce fichier sous le nom '.env' pour définir vos valeurs locales ou de production.
# NE COMMITEZ JAMAIS LE FICHIER .env DANS LE DÉPÔT GIT.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base de données PostgreSQL
# ------------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5434/samaadresse
SPRING_DATASOURCE_USERNAME=samaadresse
SPRING_DATASOURCE_PASSWORD=samaadresse

# ------------------------------------------------------------------------------
# 2. Sécurité & JWT
# ------------------------------------------------------------------------------
# Clé secrète HMAC-SHA d'au moins 256 bits (32 octets min / 48 octets recommandé pour HS384)
JWT_SECRET=samaadresse-super-secret-key-384-bits-minimum-length-for-security-zig
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# ------------------------------------------------------------------------------
# 3. URL Frontend (utilisée pour construire les URLs QR Code et SMS)
# ------------------------------------------------------------------------------
FRONTEND_BASE_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 4. Stockage des photos de façade
# ------------------------------------------------------------------------------
UPLOAD_DIR=./uploads

# ------------------------------------------------------------------------------
# 5. Partage SMS (Abstraction & Anti-fraude)
# ------------------------------------------------------------------------------
# Fournisseur SMS actif : mock | twilio | sendflash (défaut : mock)
SMS_PROVIDER=mock

# Timeout d'appel au fournisseur SMS (défaut : 5s)
SMS_TIMEOUT=5s

# Plafond global plateforme par 24h (défaut : 200 SMS / 24h)
SMS_DAILY_CAP=200

# Limite par utilisateur connecté par heure (défaut : 5 SMS / h)
SMS_USER_HOURLY_LIMIT=5

# Limite par numéro destinataire par 24h (clé = hash SHA-256 en mémoire, défaut : 3 SMS / 24h)
SMS_RECIPIENT_DAILY_LIMIT=3

# --- Configuration Twilio (requis si SMS_PROVIDER=twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_API_BASE_URL=https://api.twilio.com

# --- Configuration SendFlash (requis si SMS_PROVIDER=sendflash) ---
SENDFLASH_API_URL=https://api.sendflash.com/v1/sms/send
SENDFLASH_API_KEY=
SENDFLASH_SENDER_ID=SamaAdresse

# ------------------------------------------------------------------------------
# 6. Administrateur initial (Production uniquement - Profil prod)
# ------------------------------------------------------------------------------
# En environnement de production, l'admin initial est créé UNIQUEMENT si ces
# deux variables sont renseignées (aucun mot de passe par défaut).
# Si omises ou vides, aucun compte admin n'est créé automatiquement.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# 7. Grille géographique (Backend)
# ------------------------------------------------------------------------------
# Rayon maximal de tolérance (en kilomètres) pour rattacher un point situé dans une zone
# mais hors boîte de quartier vers le quartier le plus proche (défaut : 3.0 km).
GEO_FALLBACK_MAX_DISTANCE_KM=3.0

# ------------------------------------------------------------------------------
# 8. Cartographie & Frontend
# ------------------------------------------------------------------------------
# Fournisseur de tuiles Leaflet et attribution légale
# Par défaut : OpenStreetMap standard (aucune clé requise)
# Fournisseurs alternatifs configurables sans modification de code : MapTiler, Stadia Maps, CartoDB
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# URL de base de l'API backend pour les assets (/uploads, etc.) si hébergé sur un domaine distinct
# Laisser vide en développement local (le proxy Vite /api et /uploads redirige vers le backend)
VITE_API_BASE_URL=

