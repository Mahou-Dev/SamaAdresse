# ==============================================================================
# SamaAdresse — Modèle de configuration d'environnement (.env.example)
# ==============================================================================
# Copiez ce fichier sous le nom '.env' pour définir vos valeurs locales.
# Aucun secret ni aucune valeur pré-remplie ne figure dans ce fichier modèle.
# ==============================================================================

# 1. Profil & Serveur HTTP
SPRING_PROFILES_ACTIVE=
PORT=

# 2. Base de données PostgreSQL (Render/Neon ou JDBC local)
DATABASE_URL=
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# 3. Sécurité, JWT & Proxy
JWT_SECRET=
JWT_ACCESS_EXP=
JWT_REFRESH_EXP=
COOKIE_SECURE=
TRUSTED_PROXY_HOPS=

# 4. URL publique de l'application
FRONTEND_BASE_URL=

# 5. Stockage des photos de façade (disk en dev, db en prod)
PHOTO_STORAGE=
UPLOAD_DIR=

# 6. Administrateur initial de production (>= 12 caractères en prod)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# 7. Données de démonstration
DEMO_SEED=
DEMO_PASSWORD=

# 8. Calcul d'itinéraire OpenRouteService
ORS_API_KEY=
ORS_BASE_URL=

# 9. Partage SMS (console | mock | twilio | sendflash)
SMS_PROVIDER=
SMS_TIMEOUT=
SMS_DAILY_CAP=
SMS_USER_HOURLY_LIMIT=
SMS_RECIPIENT_DAILY_LIMIT=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_API_BASE_URL=
SENDFLASH_API_URL=
SENDFLASH_API_KEY=
SENDFLASH_SENDER_ID=

# 10. Grille géographique
GEO_FALLBACK_MAX_DISTANCE_KM=

# 11. Cartographie Frontend Vite
VITE_TILE_URL=
VITE_TILE_ATTRIBUTION=
VITE_API_BASE_URL=
