# ==============================================================================
# SamaAdresse — Modèle de configuration d'environnement (.env.example)
# ==============================================================================
# Copiez ce fichier sous le nom '.env' pour définir vos valeurs locales.
# Aucun secret ni aucune valeur pré-remplie ne figure dans ce fichier modèle.
# ==============================================================================

# 1. Base de données PostgreSQL (ex: postgres://user:pass@host/db ou jdbc:postgresql://localhost:5434/samaadresse)
DATABASE_URL=
DB_URL=
DB_USER=
DB_PASSWORD=

# 2. Sécurité & JWT (obligatoire en prod, >= 32 octets ; ex: JWT_ACCESS_EXP=900000, JWT_REFRESH_EXP=604800000)
JWT_SECRET=
JWT_ACCESS_EXP=
JWT_REFRESH_EXP=

# 3. URL publique de l'application (obligatoire en prod, doit commencer par https:// ; ex: PORT=8082)
FRONTEND_BASE_URL=
PORT=

# 4. Stockage des photos de façade (disk en dev, db en prod ; ex: UPLOAD_DIR=./uploads)
STORAGE_TYPE=
UPLOAD_DIR=

# 5. Administrateur initial de production (>= 12 caractères si défini)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# 6. Données de démonstration (jamais activé par défaut en prod ; ex: DEMO_SEED=false)
DEMO_SEED=
DEMO_PASSWORD=

# 7. Calcul d'itinéraire OpenRouteService
ORS_API_KEY=

# 8. Partage SMS (console | mock | twilio | sendflash)
SMS_PROVIDER=
SMS_TIMEOUT=
SMS_DAILY_CAP=
SMS_USER_HOURLY_LIMIT=
SMS_RECIPIENT_DAILY_LIMIT=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_API_BASE_URL=
SENDFLASH_API_URL=
SENDFLASH_API_KEY=
SENDFLASH_SENDER_ID=

# 9. Grille géographique (ex: GEO_FALLBACK_MAX_DISTANCE_KM=3.0)
GEO_FALLBACK_MAX_DISTANCE_KM=

# 10. Cartographie Frontend Vite (ex: https://tile.openstreetmap.org/{z}/{x}/{y}.png)
VITE_TILE_URL=
VITE_TILE_ATTRIBUTION=
VITE_API_BASE_URL=
