      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "demoEmail",
      "value": "demo@samaadresse.sn",
      "type": "string"
    },
    {
      "key": "demoPassword",
      "value": "",
      "type": "string"
    },
    {
