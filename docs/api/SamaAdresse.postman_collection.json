  "item": [
    {
      "name": "Parcours démo",
      "description": "Parcours complet automatisé : connexion (sauvegarde du jeton), création d'adresse, résolution publique, recherche annuaire, signalement public et calcul d'itinéraire.",
      "item": [
        {
          "name": "1. Connexion (sauvegarde du jeton)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Connexion réussie (200)', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.accessToken).to.be.a('string');",
                  "    pm.collectionVariables.set('token', jsonData.accessToken);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{demoEmail}}\",\n  \"password\": \"{{demoPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "2. Création d'adresse",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Adresse créée (201)', function () {",
                  "    pm.response.to.have.status(201);",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.code).to.match(/^ZIG-[A-Z]{3}-\\d{4}$/);",
                  "    pm.collectionVariables.set('demoCode', jsonData.code);",
                  "    pm.collectionVariables.set('demoAddressId', jsonData.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 12.5612,\n  \"longitude\": -16.2725,\n  \"description\": \"Maison d\\u00e9mo Newman, portail bleu \\u00e0 Kand\\u00e9\",\n  \"locationType\": \"MAISON\",\n  \"listed\": true,\n  \"showOwnerName\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/addresses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "addresses"
              ]
            }
          }
        },
        {
          "name": "3. Résolution publique du code",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Fiche publique résolue avec latitude, longitude et photoUrl (200)', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.code).to.eql('ZIG-KBG-4271');",
                  "    pm.expect(jsonData.latitude).to.be.a('number');",
                  "    pm.expect(jsonData.longitude).to.be.a('number');",
                  "    pm.expect(jsonData.photoUrl).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/addresses/ZIG-KBG-4271",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "addresses",
                "ZIG-KBG-4271"
              ]
            }
          }
        },
        {
          "name": "4. Recherche dans l'annuaire",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Recherche annuaire valide (200)', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.content).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/public/directory?q=Newman&quartier=KBG",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "public",
                "directory"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "Newman"
                },
                {
                  "key": "quartier",
                  "value": "KBG"
                }
              ]
            }
          }
        },
        {
          "name": "5. Signalement public",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Signalement enregistré (202)', function () {",
                  "    pm.response.to.have.status(202);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"POSITION_INCORRECTE\",\n  \"comment\": \"V\\u00e9rification automatis\\u00e9e du parcours d\\u00e9mo\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/public/addresses/{{demoCode}}/reports",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "public",
                "addresses",
                "{{demoCode}}",
                "reports"
              ]
            }
          }
        },
        {
          "name": "6. Calcul d'itinéraire",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Itinéraire calculé avec distance > 0, durée > 0 et géométrie présente (200 ou 503)', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 503]);",
                  "    if (pm.response.code === 200) {",
                  "        var jsonData = pm.response.json();",
                  "        pm.expect(jsonData.distance).to.be.above(0);",
                  "        pm.expect(jsonData.duration).to.be.above(0);",
                  "        pm.expect(jsonData.geometry).to.be.an('object');",
                  "        pm.expect(jsonData.geometry.coordinates).to.be.an('array').and.not.empty;",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/public/route?fromLat=12.5835&fromLon=-16.2712&code=ZIG-KBG-4271&profile=driving-car",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "public",
                "route"
              ],
              "query": [
                {
                  "key": "fromLat",
                  "value": "12.5835"
                },
                {
                  "key": "fromLon",
                  "value": "-16.2712"
                },
                {
                  "key": "code",
                  "value": "ZIG-KBG-4271"
                },
                {
                  "key": "profile",
                  "value": "driving-car"
                }
              ]
            }
          }
        }
      ]
    },
